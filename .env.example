# Copy → .env (gitignored). Một file cho local + tham chiếu Vercel.
#
# Local (npm run dev): để VITE_API_URL trống → Vite proxy /api → localhost:8080
# Vercel Production: paste các dòng bên dưới vào Dashboard → Environment Variables
#   (hoặc set VITE_API_URL=https://histar-postgre.onrender.com khi build prod)
#
# Override tạm: FE local gọi BE Render
# VITE_API_URL=https://histar-postgre.onrender.com
# Gọi thẳng BE local (bỏ proxy):
# VITE_API_URL=http://localhost:8080
# AI thẳng:
# VITE_AI_URL=http://localhost:8100

VITE_API_URL=
VITE_AI_URL=

# Cloudflare R2 public base (no trailing slash). Empty = same-origin /media trên Vercel.
# Custom domain example: https://media.timelens.asia
VITE_MEDIA_BASE_URL=https://media.timelens.asia

VITE_DEMO_ENABLED=false
VITE_DEMO_SECRET=
VITE_DEMO_MODE=false

# Google Maps (optional)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Google Sign-In — docs/FIREBASE_AUTH_SETUP.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=histar-a08c1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=histar-a08c1
VITE_FIREBASE_APP_ID=

# --- Vercel Production (paste vào Dashboard; không commit secret) ---
# VITE_API_URL=https://histar-postgre.onrender.com
# VITE_MEDIA_BASE_URL=https://media.timelens.asia
# VITE_DEMO_ENABLED=false
# VITE_DEMO_MODE=false
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=histar-a08c1.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=histar-a08c1
# VITE_FIREBASE_APP_ID=...
