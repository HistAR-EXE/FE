{
  "name": "exe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "predev": "node scripts/sync-ar-catalog.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-ar-catalog.mjs && node scripts/verify-public-media.mjs && node scripts/verify-film-assets.mjs && node scripts/stage-public-r2.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "ci": "npm run test:heritage-studio && npm run lint && npm run build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=setup --project=1-backend-api",
    "test:e2e:ui": "playwright test --project=setup --project=2-frontend-ui",
    "test:e2e:admin-ui": "playwright test --project=admin-ui",
    "test:e2e:admin": "playwright test --project=admin-ui --project=admin-e2e",
    "test:e2e:site-workspace": "playwright test --project=site-workspace-e2e",
    "test:e2e:site-workspace-fullstack": "playwright test -c playwright.fullstack.config.ts --project=site-workspace-fullstack",
    "test:e2e:field-trip-fullstack": "playwright test -c playwright.fullstack.config.ts --project=field-trip-fullstack",
    "test:e2e:b2-fullstack": "playwright test -c playwright.fullstack.config.ts",
    "test:e2e:full": "playwright test --project=setup --project=3-fullstack-e2e",
    "test:e2e:report": "playwright show-report",
    "test:admin": "node --experimental-strip-types --test scripts/admin-state.test.mjs scripts/admin-foundation.test.mjs scripts/admin-pages.test.mjs scripts/demo-environment-state.test.mjs",
    "test:station-journey": "node --experimental-strip-types --test scripts/station-journey.test.mjs",
    "test:ar": "node --test scripts/ar-navigation.test.mjs scripts/ar-experience.test.mjs scripts/ar-viewer-math.test.mjs scripts/ar-runtime.test.mjs && playwright test -c playwright.ar.config.ts",
    "test:ar:pwa": "node scripts/ar-pwa-browser.mjs",
    "verify:ar:deployment": "node scripts/verify-ar-deployment.mjs",
    "test:all": "powershell -ExecutionPolicy Bypass -File ../scripts/run-all-tests.ps1",
    "test:history": "node --experimental-strip-types --test scripts/history-film.test.mjs scripts/verify-film-assets.test.mjs",
    "test:photo-flow": "node --experimental-strip-types --test scripts/photo-flow.test.mjs scripts/personal-photo-frames.test.mjs scripts/photo-frame-integration.test.mjs",
    "test:photo-editor": "playwright test -c playwright.photo-editor.config.ts",
    "test:photo-segmentation": "node scripts/personal-photo-frames.browser.mjs",
    "test:saved-photos": "playwright test -c playwright.saved-photos.config.ts --grep \"saved creations use|saved review and download\"",
    "test:photo-flow:browser": "node scripts/photo-flow-browser.mjs && node scripts/original-photo-browser.mjs",
    "test:photo-flow:ui": "playwright test -c playwright.photo-flow.config.ts",
    "test:heritage": "tsx --test scripts/heritage-studio-assets.test.mjs",
    "test:heritage-studio": "tsx --test scripts/heritage-studio-assets.test.mjs scripts/heritage-catalog-validation.test.mjs scripts/heritage-3d-bridge.test.mjs scripts/heritage-face-placement.test.mjs scripts/heritage-gesture.test.mjs scripts/heritage-compositor.test.mjs scripts/heritage-studio-ui.test.mjs scripts/heritage-studio-privacy.test.mjs",
    "test:history:browser": "node scripts/history-smoke.mjs",
    "test:portal": "node --experimental-strip-types --test scripts/portal-audio.test.mjs scripts/portal-defaults.test.mjs scripts/portal-narration.test.mjs",
    "test:portal:browser": "node scripts/portal-smoke.mjs",
    "test:xua-nay:browser": "node scripts/xua-nay-smoke.mjs",
    "test:landing:browser": "node scripts/landing-smoke.mjs && node scripts/landing-edge-cases.mjs",
    "test:public-pages:browser": "node scripts/public-pages-smoke.mjs",
    "test:quest-navigation:browser": "node scripts/quest-navigation-smoke.mjs",
    "test:about-products:browser": "node scripts/about-products-smoke.mjs",
    "export:portal-narration": "node --experimental-strip-types scripts/export-portal-narration.mjs",
    "test:portal:recorded:browser": "node scripts/portal-recorded-smoke.mjs",
    "test:teacher": "node --experimental-strip-types --test scripts/teacher-workspace.test.mjs",
    "test:packages": "node --experimental-strip-types --test scripts/package-entitlements.test.mjs",
    "test:explore-videos": "node --experimental-strip-types --test scripts/explore-videos.test.mjs",
    "test:profile": "node --experimental-strip-types --test scripts/profile-workspace.test.mjs scripts/profile-details.test.mjs",
    "test:profile:browser": "node scripts/profile-fullstack-smoke.mjs",
    "test:settings": "node --experimental-strip-types --test scripts/settings-workspace.test.mjs",
    "test:settings:browser": "node scripts/settings-fullstack-smoke.mjs",
    "test:chat-voice": "node scripts/chat-voice.test.cjs",
    "test:chat-call:browser": "node scripts/chat-call-browser.mjs",
    "test:chat-call:visuals": "node scripts/chat-call-visuals.test.cjs",
    "test:chat-mouth-sync": "node scripts/chat-mouth-sync.test.cjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@photo-sphere-viewer/core": "^5.14.1",
    "@photo-sphere-viewer/markers-plugin": "^5.14.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.14.1",
    "@sentry/react": "^11.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "axios": "^1.16.1",
    "dexie": "^4.4.6",
    "firebase": "^11.10.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.3.4",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@playwright/test": "^1.61.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.1",
    "serialize-javascript": "7.1.4",
    "source-map-js": "1.2.2",
    "zod": "4.6.7"
  }
}
