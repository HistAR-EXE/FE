{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "timelens.asia"
        }
      ],
      "destination": "https://www.timelens.asia/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/media/:path*",
      "destination": "https://media.timelens.asia/media/:path*"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://histar-a08c1.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/((?!assets/|films/|vendor/ar/|ar\\.html$|ar-runtime\\.js$|ar-catalog\\.json$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/films/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
